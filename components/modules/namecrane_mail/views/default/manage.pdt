<?php /** @var View $this **/ ?>

<?php
$link_buttons = [
    [
        'name' => $this->_('NamecraneMail.add_module_row', true),
        'attributes' => ['href' => $this->base_uri . 'settings/company/modules/addrow/' . $module->id],
    ],
    [
        'name' => $this->_('NamecraneMail.add_module_group', true),
        'attributes' => ['href' => $this->base_uri . 'settings/company/modules/addgroup/' . $module->id],
    ],
];

$tabs = [
    [
        'name' => $this->_('NamecraneMail.manage.module_rows_title', true),
        'current' => true,
        'attributes' => ['class' => 'rows', 'href' => '#tab_rows', 'id' => 'rows_tab', 'data-bs-toggle' => 'tab', 'role' => 'tab'],
    ],
    [
        'name' => $this->_('NamecraneMail.manage.module_groups_title', true),
        'current' => false,
        'attributes' => ['class' => 'groups', 'href' => '#tab_groups', 'id' => 'groups_tab', 'data-bs-toggle' => 'tab', 'role' => 'tab'],
    ],
];

$this->Widget->clear();
$this->Widget->setLinkButtons($link_buttons);
$this->Widget->setTabs($tabs);
$this->Widget->setBodyWrapper(false);
$this->Widget->create(
    $this->_('AdminCompanyModules.manage.boxtitle_manage', true, isset($module->name) ? $this->Html->safe($module->name, true) : null),
    ['id' => 'manage_namecrane_mail']
);

$rows = $module->rows ?? [];
$groups = $module->groups ?? [];
?>
<div class="tab-content">
    <div class="tab-pane fade show active" id="tab_rows" role="tabpanel">
        <?php if ($rows) { ?>
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th><?php $this->_('NamecraneMail.manage.module_rows_heading.server_name'); ?></th>
                            <th><?php $this->_('NamecraneMail.manage.module_rows_heading.service_id'); ?></th>
                            <th><?php $this->_('NamecraneMail.manage.module_rows_heading.api_key'); ?></th>
                            <th><?php $this->_('NamecraneMail.manage.module_rows_heading.options'); ?></th>
                        </tr>
                    </thead>
                    <tbody>
                        <?php foreach ($rows as $row) {
                            $key = (string) ($row->meta->api_key ?? '');
                        ?>
                            <tr>
                                <td><?php $this->Html->_($row->meta->server_name ?? ''); ?></td>
                                <td><?php echo !empty($row->meta->service_id) ? '#' . $this->Html->safe($row->meta->service_id) : '<span class="text-muted">' . $this->_('NamecraneMail.manage.service_id_any', true) . '</span>'; ?></td>
                                <td><code><?php $this->Html->_($key === '' ? '' : substr($key, 0, 8) . '…'); ?></code></td>
                                <td>
                                    <a href="<?php $this->Html->_($this->base_uri . 'settings/company/modules/editrow/' . $module->id . '/' . $row->id . '/'); ?>" class="btn btn-sm btn-outline-secondary" title="<?php $this->_('NamecraneMail.manage.module_rows.edit'); ?>">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <?php
                                    $this->Form->create($this->base_uri . 'settings/company/modules/deleterow/', ['class' => 'd-inline']);
                                    $this->Form->fieldHidden('id', $module->id);
                                    $this->Form->fieldHidden('row_id', $row->id);
                                    ?>
                                    <button type="button" class="btn btn-sm btn-outline-danger modal-confirm-delete" data-confirm-message="<?php $this->Html->_($this->_('NamecraneMail.manage.module_rows.confirm_delete', true)); ?>" title="<?php $this->_('NamecraneMail.manage.module_rows.delete'); ?>">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                    <?php $this->Form->end(); ?>
                                </td>
                            </tr>
                        <?php } ?>
                    </tbody>
                </table>
            </div>
        <?php } else { ?>
            <div class="card-body text-center text-muted py-5">
                <i class="bi bi-envelope" style="font-size: 3rem; opacity: 0.3;"></i>
                <p class="mt-3 mb-0"><?php $this->_('NamecraneMail.manage.module_rows_no_results'); ?></p>
            </div>
        <?php } ?>
    </div>
    <div class="tab-pane fade" id="tab_groups" role="tabpanel">
        <?php if ($groups) { ?>
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th><?php $this->_('NamecraneMail.manage.module_groups_heading.name'); ?></th>
                            <th><?php $this->_('NamecraneMail.manage.module_groups_heading.module_rows'); ?></th>
                            <th><?php $this->_('NamecraneMail.manage.module_groups_heading.options'); ?></th>
                        </tr>
                    </thead>
                    <tbody>
                        <?php foreach ($groups as $group) { ?>
                            <tr>
                                <td><?php $this->Html->_($group->name ?? ''); ?></td>
                                <td><?php echo count($group->rows ?? []); ?></td>
                                <td>
                                    <a href="<?php $this->Html->_($this->base_uri . 'settings/company/modules/editgroup/' . $module->id . '/' . $group->id . '/'); ?>" class="btn btn-sm btn-outline-secondary" title="<?php $this->_('NamecraneMail.manage.module_groups.edit'); ?>">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <?php
                                    $this->Form->create($this->base_uri . 'settings/company/modules/deletegroup/', ['class' => 'd-inline']);
                                    $this->Form->fieldHidden('id', $module->id);
                                    $this->Form->fieldHidden('group_id', $group->id);
                                    ?>
                                    <button type="button" class="btn btn-sm btn-outline-danger modal-confirm-delete" data-confirm-message="<?php $this->Html->_($this->_('NamecraneMail.manage.module_groups.confirm_delete', true)); ?>" title="<?php $this->_('NamecraneMail.manage.module_groups.delete'); ?>">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                    <?php $this->Form->end(); ?>
                                </td>
                            </tr>
                        <?php } ?>
                    </tbody>
                </table>
            </div>
        <?php } else { ?>
            <div class="card-body text-center text-muted py-5">
                <i class="bi bi-collection" style="font-size: 3rem; opacity: 0.3;"></i>
                <p class="mt-3 mb-0"><?php $this->_('NamecraneMail.manage.module_groups.no_results'); ?></p>
            </div>
        <?php } ?>
    </div>
</div>
<?php $this->Widget->end(); ?>
