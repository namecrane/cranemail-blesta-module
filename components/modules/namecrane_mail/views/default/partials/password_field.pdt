<?php
/**
 * A password input, hidden until shown, with a generate button on forms.
 *
 * @var string $password_id
 * @var string $password_name
 * @var string $password_value
 * @var bool $password_form Whether it's a form field (required, generate button) or a read-only secret
 * @var bool $password_required
 */
$show_label = $this->_('NamecraneMail.password.show', true);
?>
<div class="ncm-password<?php echo $password_form ? '' : ' ncm-secret'; ?>" data-ncm-password>
    <input id="<?php echo $this->Html->safe($password_id); ?>"<?php echo $password_name !== '' ? ' name="' . $this->Html->safe($password_name) . '"' : ''; ?> type="password" class="form-control ncm-mono" value="<?php echo $this->Html->safe($password_value); ?>"<?php echo $password_form ? ' minlength="8" autocomplete="new-password"' : ' readonly'; ?><?php echo !empty($password_required) ? ' required' : ''; ?>>
    <button type="button" class="btn btn-light" data-ncm-toggle data-show-label="<?php echo $this->Html->safe($show_label); ?>" data-hide-label="<?php $this->_('NamecraneMail.password.hide'); ?>" title="<?php echo $this->Html->safe($show_label); ?>" aria-label="<?php echo $this->Html->safe($show_label); ?>" aria-pressed="false">
        <svg class="ncm-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/></svg>
    </button>
    <?php if ($password_form) { ?>
        <button type="button" class="btn btn-light" data-ncm-generate title="<?php $this->_('NamecraneMail.password.generate'); ?>" aria-label="<?php $this->_('NamecraneMail.password.generate'); ?>">
            <svg class="ncm-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99"/></svg>
        </button>
    <?php } ?>
</div>
